# Version the code, the configuration and the small reference data.
# Never local environments, caches, secrets or generated reports.
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.DS_Store
.env
.env.*
!.env.example
# Reports and searches written by the command line and the scripts.
autostat_*/
results/
.venv-bench/
benchmark/logs/
# Local notes and scratch work, never versioned.
.private/
# Working files PySR writes beside the script that calls it.
outputs/
